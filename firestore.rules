rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default catch-all denies access to unmapped collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to validate basic IDs
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Clients collection rules
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Farms collection rules
    match /farms/{farmId} {
      allow read, write: if true;
    }

    // Plots collection rules
    match /plots/{plotId} {
      allow read, write: if true;
    }

    // Sampling Points collection rules
    match /samplingPoints/{pointId} {
      allow read, write: if true;
    }

    // Projects collection rules
    match /projects/{projectId} {
      allow read, write: if true;
    }
  }
}
